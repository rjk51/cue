<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

<!-- Header with title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cue Reminders"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </LinearLayout>

    <!-- Reminder Count -->
    <TextView
        android:id="@+id/reminder_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 reminders today"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        android:paddingBottom="12dp" />

    <!-- Reminder List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminder_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:paddingVertical="4dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
