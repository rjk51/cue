# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# Use static frameworks to avoid dynamic framework embedding into app
# extensions and to keep Firebase Swift pods working with CocoaPods.
# Requires CocoaPods 1.11+.
use_frameworks! :linkage => :static

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Using static libraries (default) avoids embedding dynamic frameworks
  # into the app bundle which can create dependency cycles with app
  # extensions. Remove or enable `use_frameworks!` only for pods that
  # explicitly require it.

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Widget extension target: inherit search paths but do not install pods here
target 'cueWidgetsExtension' do
  # Extension should inherit search paths but not install pods to avoid
  # copying app frameworks into the extension.
  inherit! :search_paths
  # Do NOT call flutter_install_all_ios_pods for extensions —
  # this prevents duplicating framework embedding and avoids build cycles.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end

  # Fix build cycle by reordering build phases
  installer.pods_project.targets.each do |target|
    if target.name == 'Runner'
      copy_pods_phase = target.build_phases.find { |phase| phase.display_name == '[CP] Copy Pods Resources' }
      embed_phase = target.build_phases.find { |phase| phase.display_name == 'Embed App Extensions' }
      
      if copy_pods_phase && embed_phase
        target.build_phases.delete(embed_phase)
        index = target.build_phases.index(copy_pods_phase)
        target.build_phases.insert(index + 1, embed_phase)
      end
    end
  end
end
